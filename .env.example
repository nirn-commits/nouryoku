# Google AI Studio で取得した Gemini API キー（このファイルを .env にコピーして記入）
GEMINI_API_KEY=
# 使用するモデル（省略時 gemini-3.1-flash-lite：最安）。精度を上げたい場合は gemini-3.8-flash など
GEMINI_MODEL=gemini-3.1-flash-lite
# 上のモデルが使えない（存在しない・無料枠なし・上限）時に順に試す予備のモデル（カンマ区切り）
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview
# 1回の問い合わせの待ち時間上限（ミリ秒）
GEMINI_TIMEOUT_MS=30000
# 思考の深さ（Gemini 3 系）：minimal / low / medium / high。省略時は flash=minimal（高速）
# GEMINI_THINKING_LEVEL=low
# 思考トークンの上限（Gemini 2.5 系を使う場合のみ）
# GEMINI_THINKING_BUDGET=0
PORT=8787
