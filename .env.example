# Google AI Studio で取得した Gemini API キー（このファイルを .env にコピーして記入）
GEMINI_API_KEY=
# 使用するモデル（省略時 gemini-2.5-flash）
GEMINI_MODEL=gemini-2.5-flash
# 1回の問い合わせの待ち時間上限（ミリ秒）
GEMINI_TIMEOUT_MS=30000
# 思考トークンの上限。flash 系は省略時 0（思考なし・高速）。解釈の精度を上げたい場合は 1024 など
# GEMINI_THINKING_BUDGET=0
# 出力トークンの上限（思考分は別に加算）
# GEMINI_MAX_OUTPUT_TOKENS=2048
PORT=8787
